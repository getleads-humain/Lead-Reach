{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0 --webpack 2>&1 | tee dev.log",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "postinstall": "prisma generate",
    "start": "NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "start:detached": "NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 setsid node .next/standalone/server.js > /tmp/next-prod.log 2>&1 &",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "fix:security": "npx tsx scripts/fix-supabase-security.ts",
    "knowledge:reindex": "npx tsx -e \"import {getKnowledgeIndex} from './src/lib/knowledge'; getKnowledgeIndex().load(true); console.log('Knowledge base reindexed');\"",
    "knowledge:gap": "npx tsx scripts/run-gap-report.ts",
    "knowledge:embeddings": "npx tsx scripts/precompute-embeddings.ts"
  },
