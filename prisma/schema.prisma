generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active, paused, completed, archived
  targetIndustry String?
  targetLocation String?
  targetCompanySize String?
  targetCriteria String? // JSON string of ICP criteria
  leadsFound  Int      @default(0)
  leadsQualified Int   @default(0)
  leadsContacted Int   @default(0)
  leadsResponded Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]
  tasks       AgentTask[]
}

model Lead {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  // Company Info
  companyName   String
  legalName     String?
  website       String?
  industry      String?
  subIndustry   String?
  sicCode       String?
  naicsCode     String?
  
  // Location
  hqAddress     String?
  city          String?
  stateProvince String?
  country       String?
  postalCode    String?
  
  // Contact Info
  phoneMain     String?
  phoneDirect   String?
  generalEmail  String?
  supportEmail  String?
  
  // Key People
  ceoName       String?
  ceoEmail      String?
  keyContactName  String?
  keyContactTitle String?
  keyContactEmail  String?
  
  // Firmographics
  employeeCount String?
  revenueEstimate String?
  foundingYear  String?
  ownershipType String?
  
  // Digital
  linkedinUrl   String?
  twitterHandle String?
  facebookPage  String?
  techStack     String? // JSON array
  
  // Qualification
  leadScore     Int      @default(0)
  leadTier      String   @default("unqualified") // hot, warm, cold, unqualified
  firmographicScore Int  @default(0)
  intentScore   Int      @default(0)
  reachabilityScore Int @default(0)
  strategicScore Int     @default(0)
  dataCompleteness Int  @default(0)
  
  // Pipeline
  stage         String   @default("new") // new, enriched, qualified, contacted, engaged, negotiating, closed_won, closed_lost, nurture
  lastContactDate DateTime?
  nextFollowUp  DateTime?
  notes         String?
  
  // Discovery
  sources       String?  // JSON array of discovery sources
  discoveredAt  DateTime @default(now())
  enrichedAt    DateTime?
  qualifiedAt   DateTime?
  contactedAt   DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  outreach      Outreach[]
}

model Outreach {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  channel     String   // email, linkedin, phone
  type        String   // cold_email, warm_intro, connection_request, follow_up_1, follow_up_2, break_up
  subject     String?
  body        String
  status      String   @default("draft") // draft, sent, delivered, opened, replied, bounced, failed
  sentAt      DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentTask {
  id          String   @id @default(cuid())
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  
  agentName   String   // orchestrator, prospect-discovery, data-enrichment, web-research, lead-qualification, outreach-composer, pipeline-manager, report-generator
  taskType    String   // search, enrich, qualify, outreach, report, coordinate
  status      String   @default("pending") // pending, running, completed, failed, cancelled
  priority    Int      @default(5) // 1-10, 10 highest
  input       String?  // JSON string of task input
  output      String?  // JSON string of task output
  error       String?
  progress    Int      @default(0) // 0-100
  
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentReachChannel {
  id          String   @id @default(cuid())
  name        String   @unique // web, exa_search, linkedin, twitter, youtube, github, reddit, etc.
  displayName String
  description String?
  status      String   @default("unknown") // ok, warn, off, error, unknown
  tier        Int      @default(0) // 0=zero-config, 1=needs-key, 2=needs-setup
  backend     String?  // e.g. "Jina Reader", "Exa via mcporter"
  message     String?
  lastChecked DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AISetter {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active, paused, training
  avatar      String?  // emoji or icon name
  
  // Qualification Criteria
  qualificationRules String? // JSON: { mustHave: [], niceToHave: [], disqualify: [] }
  
  // Performance
  conversationsHandled Int    @default(0)
  leadsQualified      Int    @default(0)
  leadsBooked         Int    @default(0)
  conversionRate      Float  @default(0) // percentage
  avgResponseTime     Int    @default(0) // seconds
  
  // Configuration
  language     String   @default("en") // supports 17+ languages
  channels     String?  // JSON array: ["sms","whatsapp","instagram","messenger","email"]
  calendarLink String?  // booking calendar URL
  followUpEnabled Boolean @default(true)
  followUpDelay    Int    @default(3600) // seconds before first follow-up
  maxFollowUps     Int    @default(5)
  
  // GHL Integration
  ghlIntegrationId String?  // GoHighLevel integration ID
  
  // A/B Testing
  activeVariant   String? // "A" or "B"
  variantAMessage String? // JSON: greeting, qualification_prompt, booking_prompt
  variantBMessage String? // JSON: greeting, qualification_prompt, booking_prompt
  
  subAccountId String?
  subAccount   SubAccount? @relation(fields: [subAccountId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  conversations SetterConversation[]
}

model SetterConversation {
  id          String   @id @default(cuid())
  setterId    String
  setter      AISetter @relation(fields: [setterId], references: [id], onDelete: Cascade)
  
  leadName    String
  leadChannel String   // sms, whatsapp, instagram, messenger, email
  leadPhone   String?
  leadEmail   String?
  
  status      String   @default("active") // active, qualified, disqualified, booked, lost
  language    String   @default("en")
  
  // Conversation flow
  messages    String?  // JSON array of {role, content, timestamp}
  painPoints  String?  // JSON array of identified pain points
  objections  String?  // JSON array of objections raised
  
  // Qualification
  qualificationScore Int  @default(0) // 0-100
  qualificationAnswers String? // JSON: {question: answer}
  
  // Booking
  bookedAppointment Boolean @default(false)
  bookedAt          DateTime?
  appointmentDate   DateTime?
  appointmentNotes  String?
  
  // Follow-up
  followUpCount    Int      @default(0)
  lastFollowUpAt   DateTime?
  nextFollowUpAt   DateTime?
  
  // A/B
  variant String? // "A" or "B"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubAccount {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active") // active, suspended
  
  // Client info
  clientName  String?
  clientEmail String?
  industry    String?
  
  // Limits
  maxSetters  Int      @default(5)
  maxLeads    Int      @default(1000)
  currentLeads Int     @default(0)
  
  // Usage stats
  totalConversations Int @default(0)
  totalBookings      Int @default(0)
  totalQualified     Int @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  setters     AISetter[]
  customTasks CustomAITask[]
}

model CustomAITask {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // update_crm, add_tag, trigger_workflow, segment_email, custom
  status      String   @default("active") // active, paused
  
  // Configuration
  trigger     String?  // JSON: {event, conditions}
  actions     String?  // JSON array: [{type, config}]
  
  // Stats
  executionsCount Int  @default(0)
  lastExecutedAt  DateTime?
  
  subAccountId String?
  subAccount   SubAccount? @relation(fields: [subAccountId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ABTest {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("running") // running, completed, paused
  
  variantAName String  @default("Variant A")
  variantBName String  @default("Variant B")
  
  // Metrics
  variantAImpressions Int @default(0)
  variantBImpressions Int @default(0)
  variantAConversions Int @default(0)
  variantBConversions Int @default(0)
  variantAConversionRate Float @default(0)
  variantBConversionRate Float @default(0)
  
  winner String? // "A" or "B" or null
  
  startDate DateTime @default(now())
  endDate   DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ICPProfile {
  id          String   @id @default(cuid())
  name        String
  description String?

  // Firmographic
  industries     String?  // JSON array
  companySizes   String?  // JSON array
  locations      String?  // JSON array
  revenueRange   String?

  // Technographic
  requiredTech            String?  // JSON array
  preferredTech           String?  // JSON array
  techSophisticationLevel String   @default("medium")
  digitalMaturityScore    Int      @default(50)

  // Psychographic
  values       String?  // JSON array
  challenges   String?  // JSON array
  goals        String?  // JSON array
  cultureTypes String?  // JSON array

  // Behavioral
  buyingSignals      String?  // JSON array
  engagementPatterns String?  // JSON array

  // Situational
  triggerEvents     String?  // JSON array
  expansionSignals  String?  // JSON array
  complianceNeeds   String?  // JSON array

  // Economic
  budgetRange          String?
  decisionTimeline     String?
  priceSensitivity     String   @default("medium")
  lifetimeValuePotential String @default("medium")

  // Full criteria JSON for flexibility
  criteria     String?  // Full JSON of ICP criteria

  // Stats
  leadsScored  Int      @default(0)
  avgFitScore  Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FollowUpSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("active")
  
  steps       String   // JSON array: [{delay, channel, message_template}]
  totalSteps  Int      @default(0)
  
  // Stats
  enrolledCount  Int @default(0)
  completedCount Int @default(0)
  responseRate   Float @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Agent Infrastructure Models ────────────────────────────────

model AgentSession {
  id          String   @id @default(cuid())
  agentName   String   // maps to AgentName type
  sessionId   String   @unique // unique session identifier
  
  // Session state
  status      String   @default("active") // active, paused, completed, archived
  context     String?  // JSON: full conversation context, state, metadata
  
  // Model used in this session
  modelId     String   @default("glm-4.7-flash") // which GLM model powers this session
  
  // Session metrics
  messageCount     Int    @default(0)
  tokensUsed       Int    @default(0)
  tasksCompleted   Int    @default(0)
  tasksFailed      Int    @default(0)
  
  // Embedding for semantic search (stored as JSON float array for SQLite compat)
  embedding   String?  // JSON array of floats for vector similarity
  
  // Relations
  campaignId  String?
  
  // Timestamps
  startedAt   DateTime @default(now())
  lastActiveAt DateTime @default(now())
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  logs        AgentLog[]
  cronJobs    AgentCronJob[]
}

model AgentLog {
  id          String   @id @default(cuid())
  agentName   String
  sessionId   String?
  session     AgentSession? @relation(fields: [sessionId], references: [id])
  
  // Log details
  level       String   @default("info") // debug, info, warn, error, critical
  category    String   // execution, model, channel, memory, skill, plugin, system
  message     String
  metadata    String?  // JSON: structured log data (tokens, latency, etc.)
  
  // Execution context
  taskId      String?
  skillId     String?
  pluginId    String?
  
  // Performance
  durationMs  Int?     // how long the operation took
  tokensIn    Int?
  tokensOut   Int?
  
  createdAt   DateTime @default(now())
}

model AgentCronJob {
  id          String   @id @default(cuid())
  agentName   String
  sessionId   String?
  session     AgentSession? @relation(fields: [sessionId], references: [id])
  
  // Schedule
  name        String
  description String?
  schedule    String   // cron expression or interval string e.g. "0 */6 * * *" or "every_30_min"
  scheduleType String  @default("cron") // cron, fixed_rate, one_time
  timezone    String   @default("UTC")
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  
  // Task to execute
  taskType    String   // search, enrich, qualify, outreach, report, coordinate
  taskInput   String?  // JSON: input for the agent task
  
  // Status
  status      String   @default("active") // active, paused, completed, failed
  runCount    Int      @default(0)
  failCount   Int      @default(0)
  maxRuns     Int?     // null = unlimited
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentSkill {
  id          String   @id @default(cuid())
  agentName   String
  
  // Skill definition
  name        String
  displayName String
  description String
  version     String   @default("1.0.0")
  
  // Skill config
  category    String   // search, enrich, qualify, outreach, report, manage, coordinate
  inputSchema String?  // JSON Schema for skill inputs
  outputSchema String? // JSON Schema for skill outputs
  
  // Implementation
  handler     String   // function name in agent-executor.ts or agents/*.ts
  prompt      String?  // system prompt template for LLM-powered skills
  
  // Channels this skill uses
  channels    String?  // JSON array of channel names
  
  // Status
  status      String   @default("active") // active, deprecated, experimental
  priority    Int      @default(5) // execution priority
  
  // Metrics
  executionsCount Int  @default(0)
  avgDurationMs   Int  @default(0)
  successRate     Float @default(0)
  lastExecutedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentPlugin {
  id          String   @id @default(cuid())
  agentName   String
  
  // Plugin definition
  name        String
  displayName String
  description String
  version     String   @default("1.0.0")
  
  // Plugin type
  type        String   // integration, enrichment, notification, automation, analytics
  provider    String?  // e.g. "hubspot", "slack", "ghl", "zapier"
  
  // Configuration
  config      String?  // JSON: plugin configuration
  secrets     String?  // JSON: encrypted API keys / tokens (store references, not raw keys)
  
  // Hooks — which events trigger this plugin
  hooks       String?  // JSON array: ["task.completed", "lead.qualified", "pipeline.stage_changed"]
  
  // Status
  status      String   @default("active") // active, disabled, error
  enabled     Boolean  @default(true)
  
  // Metrics
  invocationsCount Int @default(0)
  lastInvokedAt    DateTime?
  lastError        String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentProfile {
  id          String   @id @default(cuid())
  agentName   String   @unique
  
  // Identity
  displayName String
  description String
  icon        String   @default("Bot") // lucide icon name
  color       String   @default("#10B981") // hex color
  
  // Personality
  persona     String?  // System persona description for LLM
  tone        String   @default("professional") // professional, friendly, technical, executive
  expertise   String?  // JSON array of expertise areas
  
  // Capabilities
  capabilities String? // JSON array: ["search", "enrich", "qualify", ...]
  channels    String?  // JSON array of available Agent-Reach channels
  
  // Model preferences
  preferredModel  String @default("glm-4.7-flash") // glm-4.7-flash or glm-4.6v-flash
  fallbackModel   String @default("glm-4.6v-flash")
  temperature     Float  @default(0.3)
  maxTokens       Int    @default(4096)
  
  // Rate limits
  maxConcurrentTasks Int @default(3)
  rateLimitPerMin    Int @default(10)
  
  // Status
  status      String   @default("active") // active, maintenance, disabled
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentConfig {
  id          String   @id @default(cuid())
  agentName   String
  
  // Config key-value
  key         String
  value       String   // JSON-encoded value
  type        String   @default("string") // string, number, boolean, json, secret
  
  // Metadata
  description String?
  category    String   @default("general") // general, model, channel, rate_limit, memory, skill
  isSecret    Boolean  @default(false)
  isRequired  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([agentName, key])
}

model AgentKey {
  id          String   @id @default(cuid())
  agentName   String
  
  // Key definition
  keyName     String   // e.g. "glm_api_key", "linkedin_api_key", "exa_api_key"
  provider    String   // e.g. "z-ai", "linkedin", "exa", "jina"
  keyType     String   @default("api_key") // api_key, oauth, token, certificate
  
  // Key value (encrypted or reference)
  keyValue    String?  // The actual key or a reference to a secrets manager
  environment String   @default("production") // development, staging, production
  
  // Status
  status      String   @default("active") // active, rotated, revoked, expired
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastRotatedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([agentName, keyName, environment])
}

// ─── User Identity Profile ────────────────────────────────

model UserProfile {
  id          String   @id @default("default")
  
  // Personal Identity
  fullName    String   @default("")
  jobTitle    String   @default("")
  email       String   @default("")
  phone       String   @default("")
  bio         String   @default("")
  location    String   @default("")
  avatarUrl   String   @default("")
  socialLinks String   @default("{}") // JSON: { linkedin, twitter, github, website }
  
  // Company
  companyName        String @default("")
  companyRole        String @default("")
  companyIndustry    String @default("")
  companySize        String @default("")
  companyWebsite     String @default("")
  companyDescription String @default("")
  companyLogoUrl     String @default("")
  
  // Portfolio
  portfolioUrl   String @default("")
  portfolioItems String @default("[]") // JSON array of PortfolioItem objects
  
  // Metadata
  onboardingComplete Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentDocumentation {
  id          String   @id @default(cuid())
  agentName   String
  
  // Doc metadata
  title       String
  category    String   @default("general") // getting_started, api, skill, plugin, config, troubleshooting
  version     String   @default("1.0.0")
  
  // Content
  content     String   // Markdown content
  examples    String?  // JSON array of code examples
  
  // Status
  status      String   @default("published") // draft, published, archived
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Prospect Discovery Chat Sessions
// ============================================================

model DiscoverySession {
  id          String   @id @default(cuid())
  userId      String?  // Null for anonymous users, set for logged-in users
  
  title       String   @default("New Discovery Session")
  
  // Conversation state (JSON serialized)
  context     String   @default("{}") // ConversationContext JSON
  
  // Metadata
  messageCount Int     @default(0)
  lastIntent  String?  // Last classified intent
  lastPersona String?  // Last active agent persona
  
  // Status
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  messages    DiscoveryMessage[]
}

model DiscoveryMessage {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String?
  
  // Message content
  role        String   // user, assistant, system
  content     String   @default("")
  
  // Agent metadata
  persona     String?  // Agent persona (scout, hound, analyst, etc.)
  intent      String?  // Classified intent
  thinking    String?  // JSON: AgentThinking
  actions     String?  // JSON: AgentAction[]
  
  // Structured data (JSON)
  prospectData String? // JSON: ProspectResult
  icpData     String?  // JSON: ICPResult
  outreachData String? // JSON: OutreachResult
  marketData  String?  // JSON: MarketResult
  scoreData   String?  // JSON: ScoreResult
  insights    String?  // JSON: InsightItem[]
  
  // Pipeline state
  pipelineState String? // JSON: PipelineState from orchestrator
  thinkTimeMs  Int?     // Thinking time in milliseconds
  
  // Status
  converted   Boolean  @default(false)
  leadId      String?
  
  createdAt   DateTime @default(now())
  
  // Relations
  session     DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ============================================================
// Vellum Core — MCP Server Configurations
// ============================================================

model McpServerConfig {
  id          String   @id @default(cuid())
  
  // Identity
  name        String
  serverId    String   @unique  // Unique identifier for MCP server lookup
  
  // Transport configuration (JSON)
  // Supported types: stdio, sse, streamable-http
  // Format: { type: "sse", url: "...", headers?: {...} }
  transport   String   // JSON: McpTransport configuration
  
  // Server settings
  enabled     Boolean  @default(true)
  defaultRiskLevel String @default("medium") // low, medium, high
  maxTools    Int      @default(50)
  allowedTools String? // JSON array of allowed tool names
  blockedTools String? // JSON array of blocked tool names
  
  // Connection state
  connectionState String @default("disconnected") // disconnected, connecting, connected, error
  lastError       String?
  toolCount       Int    @default(0)
  lastHealthCheck DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Vellum Core — Memory System
// ============================================================

model VellumMemoryNode {
  id                String   @id @default(cuid())
  content           String
  type              String   // episodic, semantic, procedural, emotional, prospective, behavioral, narrative
  fidelity          String   @default("vivid") // vivid, dim, fading, gone
  confidence        Float    @default(0.8)
  significance      Float    @default(0.5)
  stability         Float    @default(0.0)
  emotionalCharge   String?  // JSON
  sourceConversations String? // JSON array
  sourceType        String   @default("direct")
  narrativeRole     String?
  scopeId           String   // per-user isolation
  scopeType         String   @default("user") // user, team, org
  lastAccessedAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sourceEdges       VellumMemoryEdge[] @relation("SourceEdges")
  targetEdges       VellumMemoryEdge[] @relation("TargetEdges")
  triggers          VellumMemoryTrigger[]
}

model VellumMemoryEdge {
  id           String   @id @default(cuid())
  sourceId     String
  targetId     String
  relationship String   // caused-by, reminds-of, contradicts, depends-on, part-of, supersedes, resolved-by
  weight       Float    @default(1.0)
  scopeId      String
  createdAt    DateTime @default(now())
  source       VellumMemoryNode @relation("SourceEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  target       VellumMemoryNode @relation("TargetEdges", fields: [targetId], references: [id], onDelete: Cascade)
}

model VellumMemoryTrigger {
  id        String   @id @default(cuid())
  nodeId    String
  type      String   // temporal, semantic, event
  condition String   // JSON
  scopeId   String
  createdAt DateTime @default(now())
  node      VellumMemoryNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

// ============================================================
// Vellum Core — Proactivity System
// ============================================================

model VellumSchedule {
  id                  String   @id @default(cuid())
  name                String
  mode                String   // notify, script, wake, execute
  enabled             Boolean  @default(true)
  cron                String?
  timezone            String   @default("UTC")
  activeHoursStart    Int      @default(8)
  activeHoursEnd      Int      @default(22)
  maxConsecutiveRuns  Int      @default(3)
  maxDailyRuns        Int      @default(2)
  maxRetries          Int      @default(3)
  retryBackoffMs      Int      @default(5000)
  prompt              String?
  scopeId             String
  conversationId      String?
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  runCount            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model VellumFollowUp {
  id             String   @id @default(cuid())
  title          String
  description    String?
  dueAt          DateTime?
  channelId      String?
  conversationId String?
  scopeId        String
  status         String   @default("pending") // pending, completed, overdue, cancelled
  createdAt      DateTime @default(now())
  completedAt    DateTime?
}

model VellumSequence {
  id           String   @id @default(cuid())
  name         String
  steps        String   // JSON array of SequenceStep
  enrolledCount Int     @default(0)
  scopeId      String
  status       String   @default("active") // active, paused, completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// Vellum Core — Sessions
// ============================================================

model VellumSession {
  id             String   @id @default(cuid())
  title          String?
  scopeId        String
  context        String?  // JSON
  agentStates    String?  // JSON - per-agent state
  pipelineState  String?  // JSON
  memoryScopeId  String?
  activeSkills   String?  // JSON array
  status         String   @default("active") // active, completed, archived
  messageCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       VellumMessage[]
}

model VellumMessage {
  id            String   @id @default(cuid())
  sessionId     String
  role          String   // user, assistant, system, agent
  content       String
  agentName     String?  // Which agent produced this
  agentPersona  String?
  thinking      String?  // Thinking content
  thinkingTimeMs Int?
  intent        String?
  actions       String?  // JSON
  toolCalls     String?  // JSON
  toolResults   String?  // JSON
  memoryUsed    Boolean  @default(false)
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
  session       VellumSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ============================================================
// Vellum Core — MCP Servers
// ============================================================

model VellumMcpServer {
  id          String   @id @default(cuid())
  name        String
  transportType String  // stdio, sse, streamable-http
  transportConfig String // JSON
  enabled     Boolean  @default(true)
  defaultRiskLevel String @default("high")
  maxTools    Int      @default(20)
  allowedTools String? // JSON array
  blockedTools String? // JSON array
  scopeId     String
  status      String   @default("disconnected") // connected, disconnected, error
  lastConnectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
