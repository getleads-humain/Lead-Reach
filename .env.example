# ══════════════════════════════════════════════════════════════════════════
# LeadReach — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env.local:  cp .env.example .env.local
#   2. Fill in the values for your environment
#   3. NEVER commit .env.local to version control (it's gitignored)
#
# The app will run in "demo mode" (auth disabled, no database) when
# Supabase credentials are missing. This is by design — the UI still renders.
#
# TO GET YOUR SUPABASE CREDENTIALS:
#   1. Go to https://supabase.com/dashboard
#   2. Select your project (or create one at https://supabase.com/new)
#   3. Navigate to Settings → API
#   4. Copy values as indicated below
#
# SECURITY MODEL:
#   - NEXT_PUBLIC_ prefix = safe for browser (inlined by Next.js at build time)
#   - No prefix = server-only (NEVER accessible in browser code)
#   - .env.local is gitignored and overrides .env for local development
#   - .env.example is the ONLY env file committed to git (contains only placeholders)
#
# ══════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────

# Local SQLite database path (used by Prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Supabase ────────────────────────────────────────────────────────────────
# ⚠️  These are REQUIRED for auth, profiles, and subscriptions to work.
#     The app renders without them (demo mode) but auth features are disabled.

# Project URL — from Dashboard → Settings → API → Project URL
# Example: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key — from Dashboard → Settings → API → Project API keys → anon public
# This key is safe for the browser — it respects Row Level Security (RLS) policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key — from Dashboard → Settings → API → Project API keys → service_role
# ⚠️  SECRET: Bypasses Row Level Security — ONLY use in server-side API routes
# ⚠️  NEVER expose this key in client-side code, browser bundles, or public repos
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI / LLM ────────────────────────────────────────────────────────────────
# ⚠️  Server-only — never expose API keys client-side.

# Zhipu AI API key — used for LeadReach's 8-agent architecture
# Get from: https://open.bigmodel.cn/ → API Keys
ZHIPU_API_KEY=your-zhipu-api-key

# Exa Search API key — AI-powered semantic web search used by Scout, Forge, Sage,
# Bard and the prospect-discovery pipeline. Zero-config: works the moment a key
# is set. Powers: Prospect Discovery, Data Enrichment, Web Research, Lead
# Qualification, and Outreach Composer.
# Get from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# ── Knowledge Base (optional) ──────────────────────────────────────────────
# When true, the knowledge base uses Z.AI embedding-3 for hybrid BM25 + semantic
# retrieval (better recall on paraphrased queries). Embeddings are pre-computed
# at index time and persisted to .knowledge-embeddings.cache.json.
# Default: false (BM25 only — fast, deterministic, no API calls).
USE_KNOWLEDGE_EMBEDDINGS=false

# ── Stripe ──────────────────────────────────────────────────────────────────
# ⚠️  STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-only.

# Stripe secret key (server-only — use sk_test_ for development)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Stripe publishable key (safe for browser — use pk_test_ for development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Stripe webhook signing secret (server-only — from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ── Security Configuration ──────────────────────────────────────────────────

# Comma-separated list of allowed origins for CORS
# ⚠️  Do not use wildcard (*) in production
ALLOWED_ORIGINS=https://leadreach.ai,https://app.leadreach.ai

# CSP violation report URI (relative path or absolute URL)
CSP_REPORT_URI=/api/security/csp-report

# ── Application ─────────────────────────────────────────────────────────────

# Base URL of the application (used for OAuth redirects and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# ── Data Source Channels (Phase 1) ─────────────────────────────────────────
# PublicWWW — tech-stack & footprint discovery (Scout agent)
# Get a key at https://publicwww.com/profile/api_status.xml
PUBLICWWW_API_KEY=

# OpenCorporates — official company registry (Augment agent, free tier)
# Get a free token at https://opencorporates.com/api/accounts/register
OPENCORPORATES_API_TOKEN=

# ── Python Worker Sidecar (Newspaper3k, BeautifulSoup) ─────────────────────
NEWS_WORKER_PORT=5341
NEWS_WORKER_URL=http://localhost:5341
