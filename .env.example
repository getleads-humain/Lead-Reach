# ============================================================
# LeadReach — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# The .env file is gitignored and will NEVER be committed.
#
# SECURITY: Per SECURITY_POLICY.md Section 9.4:
#   - All secrets are stored as environment variables — never in code
#   - Production secrets use a secrets manager with automatic rotation
#   - API keys are rotated every 90 days (service) / 180 days (integration)
#   - Secret scanning is enforced at the repository level
# ============================================================

# ── Supabase PostgreSQL (Primary Database) ─────────────────────
# Prisma Client query connection (use pooler URL for production)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Prisma migration connection (must be direct, not pooler)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── Supabase Project ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
# ⚠️  SERVICE_ROLE_KEY: Never expose to the client. Server-side only.
#     Has full database access bypassing RLS. Treat as Restricted per data classification.
SUPABASE_PUBLISHABLE_KEY="[YOUR-PUBLISHABLE-KEY]"
SUPABASE_PROJECT_REF="[YOUR-PROJECT-REF]"

# Optional: Connection pooler (uncomment when pooler is provisioned)
# SUPABASE_POOLER_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Zhipu AI GLM (LLM Provider) ──────────────────────────────
# Format: {id}.{secret} — converted to JWT at runtime via zhipu-jwt.ts
# ⚠️  Never expose to the client. Used server-side only for LLM API calls.
ZHIPU_API_KEY="[YOUR-ZHIPU-API-KEY]"

# ── Stripe (Payment Processing) ──────────────────────────────
# ⚠️  SECRET key: Server-side only. Used for checkout sessions and webhooks.
STRIPE_SECRET_KEY="sk_test_[YOUR-STRIPE-SECRET-KEY]"
# Publishable key: Safe for client-side (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_[YOUR-STRIPE-PUBLISHABLE-KEY]"
# Webhook secret: Used to verify Stripe webhook signatures (HMAC-SHA256)
STRIPE_WEBHOOK_SECRET="whsec_[YOUR-WEBHOOK-SECRET]"

# ── Bilibili Platform (Video Search API Keys) ────────────────
# Comma-separated list of Bilibili platform appkeys for video search.
# Required for the Prospect Discovery Bilibili integration.
BILIBILI_API_KEYS="[YOUR-BILIBILI-KEY-1],[YOUR-BILIBILI-KEY-2],[YOUR-BILIBILI-KEY-3]"

# ── Security Configuration ──────────────────────────────────
# Comma-separated list of allowed origins for CORS (no wildcards in production)
# Example: "https://leadreach.ai,https://app.leadreach.ai"
ALLOWED_ORIGINS="https://leadreach.ai"

# CSP Report URI (internal endpoint for CSP violation monitoring)
# CSP_REPORT_URI="/api/security/csp-report"
