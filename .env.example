# LeadReach — Environment Variables Template
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit actual secrets to version control.

# ── Database ────────────────────────────────────────────────────────

DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Supabase ────────────────────────────────────────────────────────
# ⚠️  WARNING: These keys are sensitive. Never expose them in client-side code
#     unless prefixed with NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI / LLM ────────────────────────────────────────────────────────
# ⚠️  WARNING: Never expose API keys client-side.

ZHIPU_API_KEY=your-zhipu-api-key

# ── Stripe ──────────────────────────────────────────────────────────
# ⚠️  WARNING: STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must NEVER be
#     exposed client-side. Use server-only API routes for Stripe operations.

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ── Security Configuration ──────────────────────────────────────────

# Comma-separated list of allowed origins for CORS
# ⚠️  WARNING: Do not use wildcard (*) in production
ALLOWED_ORIGINS=https://leadreach.ai,https://app.leadreach.ai

# CSP violation report URI (relative path or absolute URL)
CSP_REPORT_URI=/api/security/csp-report

# ── Application ─────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
