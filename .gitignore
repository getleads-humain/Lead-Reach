# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# database (contains runtime data, not source)
/db/

# downloads (generated files)
/download/

# upload (user-uploaded files)
/upload/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (contains secrets — never commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow .env.example to be committed (it contains only placeholders)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log

# temp / scratch
test
prompt
tmp/
temp/

# Skills directory (internal tooling)
/skills/

# Agent context (session data)
/agent-ctx/

# Worklog (session data)
worklog.md

# Mini services runtime
mini-services/*/node_modules/
mini-services/*/venv/
mini-services/*/__pycache__/
mini-services/**/*.pyc

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
__pycache__/
*.pyc
mini-services/gmaps-scraper/.venv/
mini-services/scraper-service/.venv/
*.venv/
vellum-assistant/

# ── Phase 1: Data Source Channels ─────────────────────────────────────────
# Python worker sidecars
python-workers/*/.venv/
python-workers/*/*.pid
python-workers/*/*.log
python-workers/*/__pycache__/
.news-worker-pid
.server-pid

# Runtime PID files (should never be committed)
.server.pid
server.pid
.zscripts/dev.pid
.zscripts/mini-service-*.log

# Knowledge base embeddings cache (runtime artifact, regenerated by npm run knowledge:embeddings)
.knowledge-embeddings.cache.json

# Tool-results scratch dir (agent-only, never user-visible)
tool-results/

# ── Crawl4AI integration (vendored unclecode/crawl4ai 0.9.0) ───────────────
# The vendored source is committed (lib/crawl4ai-source/) so the platform
# has full offline access to crawl4ai's API. We exclude:
#   - The upstream .git/ folder (we don't want a nested git repo)
#   - Python bytecode caches
#   - The crawl4ai HTTP service runtime artifacts (PID, log, cache)
#   - The local venv (if anyone creates one inside lib/)
lib/crawl4ai-source/.git/
lib/crawl4ai-source/.git
lib/crawl4ai-source/**/__pycache__/
lib/crawl4ai-source/**/*.pyc
lib/crawl4ai-source/.venv/
lib/crawl4ai-source/venv/
lib/crawl4ai-source/.pytest_cache/
lib/crawl4ai-source/.coverage
lib/crawl4ai-source/htmlcov/
lib/crawl4ai-source/dist/
lib/crawl4ai-source/build/
lib/crawl4ai-source/*.egg-info/

# Crawl4AI service runtime artifacts (regenerated on startup)
lib/crawl4ai-service/server.pid
lib/crawl4ai-service/server.log
lib/crawl4ai-service/.cache/

# Crawl4AI internal cache (browser cache, page cache)
.crawl4ai-cache/
.crawl4ai/
