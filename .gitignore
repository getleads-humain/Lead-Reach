# Tool-results scratch dir (agent-only, never user-visible)
tool-results/

# ── Crawl4AI integration (vendored unclecode/crawl4ai 0.9.0) ───────────────
# The vendored source is committed (lib/crawl4ai-source/) so the platform
# has full offline access to crawl4ai's API. We exclude:
#   - The upstream .git/ folder (we don't want a nested git repo)
#   - Python bytecode caches
#   - The crawl4ai HTTP service runtime artifacts (PID, log, cache)
#   - The local venv (if anyone creates one inside lib/)
#   - Upstream Python lock files (uv.lock, requirements.txt, etc.)
#     These belong to the crawl4ai upstream project, NOT to Lead Reach.
#     Lead Reach's actual crawl4ai integration lives in
#     lib/crawl4ai-service/server.py which imports crawl4ai as a Python
#     SOURCE TREE via sys.path.insert — it does NOT install crawl4ai via
#     pip and does NOT consume these lock files. Keeping them in git
#     caused 70+ Dependabot false positives (nltk, aiohttp, pypdf,
#     litellm, pyjwt, cryptography, urllib3, pillow, lxml, etc.)
#     because Dependabot scanned them as if Lead Reach pinned those
#     transitive packages. They are upstream artifacts only.
lib/crawl4ai-source/.git/
lib/crawl4ai-source/.git
lib/crawl4ai-source/**/__pycache__/
lib/crawl4ai-source/**/*.pyc
lib/crawl4ai-source/.venv/
lib/crawl4ai-source/venv/
lib/crawl4ai-source/.pytest_cache/
lib/crawl4ai-source/.coverage
lib/crawl4ai-source/htmlcov/
lib/crawl4ai-source/dist/
lib/crawl4ai-source/build/
lib/crawl4ai-source/*.egg-info/
# Upstream lock/manifest files — never tracked by Lead Reach:
lib/crawl4ai-source/uv.lock
lib/crawl4ai-source/requirements.txt
lib/crawl4ai-source/Pipfile
lib/crawl4ai-source/Pipfile.lock
lib/crawl4ai-source/poetry.lock
lib/crawl4ai-source/**/requirements.txt
lib/crawl4ai-source/**/requirements*.txt
lib/crawl4ai-source/**/*.lock
lib/crawl4ai-source/sbom/

# Crawl4AI service runtime artifacts (regenerated on startup)
lib/crawl4ai-service/server.pid
lib/crawl4ai-service/server.log
lib/crawl4ai-service/.cache/

# Crawl4AI internal cache (browser cache, page cache)
.crawl4ai-cache/
.crawl4ai/
